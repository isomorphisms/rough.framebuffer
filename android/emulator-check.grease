set -o errexit -o nounset -o pipefail
mkdir -p build/android/emulator
adb install -r build/android/roughart-x86_64.apk
adb logcat -c
adb shell am start -W -n org.isomorphisms.roughframebuffer/android.app.NativeActivity
sleep 4
adb exec-out screencap -p > build/android/emulator/before.png
adb shell input swipe 280 580 800 580 650
sleep 4
adb exec-out screencap -p > build/android/emulator/after-drag.png
adb shell input tap 550 700
sleep 4
adb exec-out screencap -p > build/android/emulator/after-tap.png
adb shell input swipe 550 700 550 1800 650
sleep 4
adb exec-out screencap -p > build/android/emulator/after-zoom.png
adb shell am force-stop org.isomorphisms.roughframebuffer
adb shell am start -W -n org.isomorphisms.roughframebuffer/android.app.NativeActivity
sleep 4
adb exec-out screencap -p > build/android/emulator/after-restart.png
adb logcat -d -s RoughFrameArt:I > build/android/emulator/native-frame-log.txt
grep -E 'FRAME input_seq=.*painted=[1-9][0-9]*' build/android/emulator/native-frame-log.txt
grep -Eq 'FRAME input_seq=.*aa_samples=4' build/android/emulator/native-frame-log.txt
grep -Eq 'FRAME input_seq=.*shape=enneper.*distance=6\.[0-9]+' build/android/emulator/native-frame-log.txt
for image in before after-drag after-tap after-zoom after-restart {
    ffmpeg -hide_banner -loglevel error -y -i "build/android/emulator/$image.png" \
        -vf 'crop=iw*3/4:ih*2/3:iw/8:ih/6,scale=160:160' \
        -frames:v 1 -pix_fmt rgb24 -f rawvideo "build/android/emulator/$image.rgb"
}
build/android/aici-screen-witness build/android/emulator/before.rgb build/android/emulator/after-drag.rgb
build/android/aici-screen-witness build/android/emulator/after-drag.rgb build/android/emulator/after-tap.rgb
build/android/aici-screen-witness build/android/emulator/after-tap.rgb build/android/emulator/after-zoom.rgb
build/android/aici-screen-witness build/android/emulator/after-zoom.rgb build/android/emulator/after-restart.rgb
# Hostile control: unchanged screenshots must be rejected by the same checker.
if build/android/aici-screen-witness build/android/emulator/before.rgb build/android/emulator/before.rgb {
    echo 'Unchanged screen was incorrectly accepted' >&2
    exit 1
}
sha256sum build/android/emulator/*.png
