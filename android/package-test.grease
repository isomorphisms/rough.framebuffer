#!/usr/bin/env grease
# Stable public-test update, using the maintained packager and the accepted
# independent FP -> AICI APK gate. No key generation or fallback signer.
set -o errexit -o nounset -o pipefail
var root = "$(dirname -- "$(dirname -- "$(realpath -- "$0")")")"
var packager = ENV.ANDROID_NDK_REPO
var policy = ENV.AICI_CHECKOUT
var pipes = ENV.FP_CHECKOUT
var prior = ENV.ROUGH_PRIOR_APK_DIRECTORY
test "$(git -C "$packager" rev-parse HEAD)" = 11edd1e0d9748d7c618413ec9f5afad52049046a
test "$(git -C "$policy" rev-parse HEAD)" = 5ec09e2f8b38b8dcc97805da44b3b87c62224116
test "$(git -C "$pipes" rev-parse HEAD)" = d70159ff1dddefb163eb32fdd1c51335b9128fdc
setglobal ENV.ANDROID_PACKAGE_ID = 'org.isomorphisms.roughframebuffer'
setglobal ENV.ANDROID_VERSION_CODE = '2'
setglobal ENV.ANDROID_VERSION_NAME = '0.2-c67-test'
setglobal ENV.ANDROID_MIN_SDK = '21'
setglobal ENV.ANDROID_TARGET_SDK = '34'
setglobal ENV.ANDROID_EXPECTED_LABEL = 'Rough Mathematical Art'
setglobal ENV.ANDROID_EXPECTED_CERT_SHA256 = 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9'
setglobal ENV.ANDROID_SOURCE_COMMIT = "$(git -C "$root" rev-parse HEAD)"
setglobal ENV.ANDROID_APP_ROOT = root
setglobal ENV.ANDROID_NDK_CHECKOUT = packager
for abi in armeabi-v7a arm64-v8a x86_64 {
    # FP uses GITHUB_RUN_ID for run names. Separate ABI roots preserve all
    # three receipts instead of colliding on the second package in CI.
    setglobal ENV.FLEXIBLE_PIPES_RUNS_ROOT = "$root/build/android/fp-runs/$abi"
    var apk = "$root/build/android/roughart-$abi.apk"
    bash "$packager/apk/build-nativeactivity-apk.sh" \
        "$root/android/AndroidManifest.xml" \
        "$root/build/android/$abi/libroughart.so" "$abi" "$apk"
    setglobal ENV.ANDROID_APK = apk
    setglobal ENV.ANDROID_PACKAGER_RECEIPT = "$root/build/android/roughart-$abi.receipt.tsv"
    setglobal ENV.ANDROID_EXPECTED_ABI = abi
    setglobal ENV.ANDROID_PRIOR_PRODUCER_RECEIPT = "$prior/roughart-$abi.receipt.tsv"
    setglobal ENV.ANDROID_PRODUCER_RECEIPT_OUTPUT = "$root/build/android/aici-$abi.receipt.tsv"
    test -s "$[ENV.ANDROID_PRIOR_PRODUCER_RECEIPT]"
    # Compatibility boundary: invoke the existing FP runner, not a new runner.
    python3 "$pipes/scripts/run-pipeline" android-apk-preflight
    grep -Fx 'result	PASS' "$[ENV.ANDROID_PRODUCER_RECEIPT_OUTPUT]"
    grep -Fx 'update_identity_result	PASS' "$[ENV.ANDROID_PRODUCER_RECEIPT_OUTPUT]"
}
printf '\033[32mPASS\033[0m stable test signer and independent single-ABI update checks\n'
